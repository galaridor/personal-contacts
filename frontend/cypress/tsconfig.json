{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["cypress"],
    "sourceMap": false,
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true
  },
  "include": ["**/*.ts", "../cypress.config.ts", "../src/app/core/models/**/*.ts"]
}
